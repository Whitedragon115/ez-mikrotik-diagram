# SQLite database for saved configs (path is relative to the project root)
DATABASE_URL="file:./data/app.db"

# ---- Discord login (required for saving configs) ----
# 1. https://discord.com/developers/applications → New Application
# 2. OAuth2 → copy the Client ID and reset/copy the Client Secret below
# 3. OAuth2 → Redirects → add: ${APP_URL}/api/auth/discord/callback
#    e.g. http://localhost:3000/api/auth/discord/callback
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Public URL of this app, used to build the Discord redirect URL (no trailing slash)
APP_URL="http://localhost:3000"

# Signs the login cookie. Keep it secret; changing it logs everyone out.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# Allow "Connect read-only" router import from the server (off in production unless "true")
ROUTER_IMPORT_ENABLED=""
